<?xml version="1.0" encoding="utf-8"?>
<!-- Vib-Ribbon on Android: what both APKs share (task 4.20). Each flavor's own manifest
     (src/quest, src/flat) adds its activity and what only it needs. The activity is SDL's
     own; it loads libSDL3.so and our libmain.so and calls main(). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:name="android.hardware.vulkan.level" android:required="true" android:version="0" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Rumble on a gamepad (the Vibration setting). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reading music from the device's own Music folder (S.2), asked for when the music picker first opens. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:allowBackup="false"
        android:hasCode="true">
    </application>
</manifest>
